{
  "name": "game-v5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^26.13.1",
    "npm": "^11.20.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-dependency-types.ts",
    "typecheck": "tsc --build",
    "lint:code": "oxlint . --type-aware --max-warnings 0 --report-unused-disable-directives",
    "lint:specs": "node scripts/lint-specs.ts",
    "compendium:check": "node scripts/compendium-check.ts",
    "docs:generate": "node scripts/derived-docs.ts generate",
    "docs:check": "node scripts/derived-docs.ts check",
    "terms:report": "node scripts/terms-report.ts",
    "docs:link-terms": "node scripts/link-terms.ts",
    "docs:plain": "node scripts/plain-docs.ts",
    "specs:budget": "node scripts/word-budgets.ts",
    "balance:bench": "node --watch tools/gdr-balance-bench/server.ts",
    "autopilot:bench": "node --watch-path=tools/autopilot-bench/server.ts tools/autopilot-bench/server.ts",
    "rating:bench": "node --watch tools/combat-rating-bench/server.ts",
    "sweep:bench": "node --watch tools/cr-sweep-bench/server.ts",
    "lint": "npm run lint:specs && npm run lint:code",
    "lint:fix": "npm run lint:specs && npm run lint:code -- --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch --no-open",
    "test:coverage": "vitest run --coverage",
    "hooks:install": "git config core.hooksPath .githooks",
    "fix": "npm run docs:link-terms && npm run docs:generate && npm run format && npm run lint:code -- --fix",
    "check:commit": "npm run lint:specs && npm run compendium:check && npm run docs:check && npm run format:check && npm run lint:code",
    "check": "npm run lint:specs && npm run compendium:check && npm run docs:check && npm run format:check && npm run lint:code && npm run test && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/ui": "5.1.1",
    "github-slugger": "2.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
