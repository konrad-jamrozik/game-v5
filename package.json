{
  "name": "game-v5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-dependency-types.ts",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "lint:code": "oxlint . --type-aware --max-warnings 0 --report-unused-disable-directives",
    "lint:specs": "node scripts/lint-specs.ts",
    "lint": "npm run lint:code && npm run lint:specs",
    "lint:fix": "npm run lint:code -- --fix && npm run lint:specs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch --no-open",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "github-slugger": "2.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
