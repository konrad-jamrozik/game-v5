#!/bin/sh

HOOK_NAME=commit
. "$(dirname "$0")/run-step.sh"

run_step "specification lint" "Fix the specification problems listed above by hand; \"npm run lint:specs\" reruns the check." \
  node scripts/lint-specs.ts
run_step "Compendium check" "Fix the Compendium problems listed above by hand; \"npm run compendium:check\" reruns the check." \
  node scripts/compendium-check.ts
run_step "derived docs" "Run \"npm run docs:generate\" to regenerate the derived docs, then commit the result." \
  node scripts/derived-docs.ts check
run_step "formatting" "Run \"npm run format\" to format the files listed above, then commit the result." \
  node node_modules/oxfmt/bin/oxfmt . --check
run_step "code lint" "Run \"npm run lint:code -- --fix\"; fix by hand whatever it cannot fix." \
  node node_modules/oxlint/bin/oxlint . --type-aware --max-warnings 0 --report-unused-disable-directives
